# herdr-managed: regenerated on `herdr integration install`
pi/agent/extensions/herdr-agent-state.ts
nvim/neovim_tips/user_tips.md
opencode/service.json
opencode/opencode-notifier-state.json

# pi skills resolve outside the repo via ~/.agents/skills/
# (`/*`, not `/`: git cannot re-include a path under an ignored directory)
pi/agent/skills/*
# pr-visual-recap: tracked here while it is tested with pi
!pi/agent/skills/pr-visual-recap/
# herdr-app, herdr-core: thin wrappers that load the manual from the installed CLI
!pi/agent/skills/herdr-app/
!pi/agent/skills/herdr-core/
# pi extension installs: keep the manifest, drop the installed tree
pi/agent/npm/node_modules/
pi/agent/npm/package-lock.json
bin/islocked
.DS_Store

# claude mods: engine regenerates types and tsconfig on every load
claude/mods/*/.claude-plugin/types/
claude/mods/*/tsconfig.json
