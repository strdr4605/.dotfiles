#!/usr/bin/env bash
# Usage: gh-my-new-repo [repo-name] [--public]
# Creates a private repo by default. The first pushed branch becomes the default branch.

set -e

VISIBILITY=--private
REPO_NAME=

for arg in "$@"; do
  case "$arg" in
    --public) VISIBILITY=--public ;;
    *) REPO_NAME="$arg" ;;
  esac
done

REPO_NAME="${REPO_NAME:-$(basename "$PWD")}"

if [[ ! -d .jj ]] && [[ ! -d .git ]]; then
  echo "Error: not in a jj or git repo"
  exit 1
fi

REPO_FULL="$(gh api user -q .login)/$REPO_NAME"

gh repo create "$REPO_FULL" "$VISIBILITY" --disable-wiki

REMOTE_URL="git@github.com:${REPO_FULL}.git"

if command -v jj >/dev/null && [[ -d .jj ]]; then
  jj git remote add origin "$REMOTE_URL"
else
  git remote add origin "$REMOTE_URL"
fi

gh repo edit "$REPO_FULL" \
  --enable-projects=false \
  --enable-squash-merge \
  --enable-rebase-merge \
  --enable-merge-commit=false \
  --delete-branch-on-merge
