#!/bin/sh
# Reopen the Claude sessions that worked on a PR.
#
# USAGE (in a Herdr pane or an hc terminal, from the repo directory):
#
#   $ pr-resume 1640
#
# Claude writes a hidden block at the end of each PR body that it creates:
#
#   <!-- author-sessions
#   updated: 2026-11-06
#   main:  <session-id>  dir: ~/code/my-repo     # implement + PR
#   herdr: <session-id>  dir: ~/code/my-repo     # code-review pane
#   -->
#
# Herdr TUI (HERDR_ENV=1): a live session gets focus. The other sessions open
# in one new tab "PR <number>", one pane each, with "claude --resume <session-id>".
#
# hc (HC_TERMINAL_ID set, for example the agents VM): a live session prints its
# terminal address. The other sessions start in new hc terminals "pr-<number>-<role>".
#
# The repo comes from the jj or git remote "origin" of the current directory,
# else from DEFAULT_REPO in ~/.config/open-ref.
#
# REQUIREMENTS: herdr or hc, jq, gh, and jj or git.
set -eu

[ -f "$HOME/.config/open-ref" ] && . "$HOME/.config/open-ref"
DEFAULT_REPO=${DEFAULT_REPO:-}

main() {
  if [ -n "${HC_TERMINAL_ID:-}" ]; then
    backend=hc
  elif [ "${HERDR_ENV:-}" = 1 ]; then
    backend=herdr
  else
    fail "Run pr-resume inside a Herdr pane or an hc terminal."
  fi
  pr=${1:?usage: pr-resume <pr-number>}

  repo=$(repo_of .)
  [ -n "$repo" ] || fail "No origin remote here. Set DEFAULT_REPO in ~/.config/open-ref."

  sessions=$(gh pr view "$pr" -R "$repo" --json body -q .body | sessions_in)
  [ -n "$sessions" ] || fail "PR #$pr has no author-sessions block."

  live=$(live_sessions)
  last_pane=

  # Herdr calls read /dev/null, so they do not eat the session lines on stdin.
  while read -r role id dir; do
    pane=$(printf '%s\n' "$live" | awk -v id="$id" '$1 == id { print $2; exit }')

    if [ -n "$pane" ]; then
      focus "$role" "$id" "$pane"
      continue
    fi

    if [ ! -d "$dir" ]; then
      echo "$role $id: skipped, no directory $dir"
      continue
    fi

    resume "$role" "$id" "$dir"
  done <<EOF
$sessions
EOF
}

# Print "role id dir" for each session line of the author-sessions block on stdin.
# shortcut: a dir with spaces breaks the parse; quote dirs in the block if that ever happens.
sessions_in() {
  tr -d '\r' | awk -v home="$HOME" '
    /<!-- author-sessions/ { on = 1; next }
    on && /-->/ { exit }
    on && $1 ~ /^(main|herdr):$/ && length($2) == 36 && $2 ~ /^[0-9a-f-]+$/ && $3 == "dir:" {
      dir = $4
      if (dir ~ /^~\//) dir = home substr(dir, 2)
      sub(":", "", $1)
      print $1, $2, dir
    }
  '
}

# Print "session-id pane" for each live Claude session.
live_sessions() {
  if [ "$backend" = herdr ]; then
    herdr agent list | jq -r '.result.agents[] | select(.agent_session.value) | "\(.agent_session.value) \(.pane_id)"'
    return
  fi

  # hc: the foreground pid of a terminal names its Claude session file.
  for t in $(hc ls --json </dev/null | jq -r '.terminals[].address'); do
    pid=$(hc get "$t" --json </dev/null | jq -r '.foreground.pid // empty')
    [ -n "$pid" ] || continue
    file="$HOME/.claude/sessions/$pid.json"
    if [ -f "$file" ]; then
      printf '%s %s\n' "$(jq -r .sessionId "$file")" "$t"
    fi
  done
}

# Show live session $2 (role $1) in pane or terminal $3.
focus() {
  if [ "$backend" = herdr ]; then
    herdr agent focus "$3" >/dev/null </dev/null
    echo "$1 $2: live in $3, focused"
  else
    echo "$1 $2: live in $3 (hc attach $3)"
  fi
}

# Start "claude --resume $2" (role $1) in directory $3.
resume() {
  if [ "$backend" = herdr ]; then
    last_pane=$(open_pane "$3" "$last_pane")
    herdr pane run "$last_pane" "claude --resume $2" >/dev/null </dev/null
    echo "$1 $2: resumed in $last_pane"
  else
    name="pr-$pr-$1"
    hc run --bg --no-parent --name "$name" --cwd "$3" claude --resume "$2" >/dev/null </dev/null
    echo "$1 $2: resumed in hc terminal $name (hc attach $name)"
  fi
}

# Herdr TUI: print the id of a new pane in directory $1.
# The first pane opens a new tab "PR <number>". The next panes split pane $2 to the right.
open_pane() {
  if [ -z "$2" ]; then
    herdr tab create --workspace "$HERDR_WORKSPACE_ID" --cwd "$1" --label "PR $pr" --focus </dev/null |
      jq -r '.result.root_pane.pane_id'
  else
    herdr pane split "$2" --direction right --cwd "$1" --no-focus </dev/null |
      jq -r '.result.pane.pane_id'
  fi
}

# Print "owner/repo" from the "origin" remote of directory $1.
repo_of() {
  url=$(cd "$1" 2>/dev/null && { jj git remote list 2>/dev/null | awk '$1 == "origin" { print $2 }'; git remote get-url origin 2>/dev/null; } | head -1)
  slug=$(printf '%s' "$url" | sed -E 's#^.*github\.com[:/]##; s#\.git$##')
  printf '%s\n' "${slug:-$DEFAULT_REPO}"
}

fail() {
  printf '%s\n' "$1" >&2
  exit 1
}

main "$@"
