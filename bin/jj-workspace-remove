#!/usr/bin/env bash
set -e

# Removes a jj workspace and its directory, the way `git worktree remove` works.
# Run this from the repo container directory (the one holding .jjmain), NOT from
# inside the workspace you're removing.
#
# jj snapshots the working copy into a commit before it deletes the workspace, so
# uncommitted work is not lost silently: find it in `jj log` and bookmark it.
#
# Examples of call:
# jj-workspace-remove jj-ws-2
# => Forgets workspace jj-ws-2 and removes ./jj-ws-2

name=$1

if [ -z "$name" ]; then
  echo "usage: jj-workspace-remove <dir-name>" >&2
  exit 1
fi

if [ ! -d .jjmain ]; then
  echo "no .jjmain in $(pwd) — cd into the repo container directory first" >&2
  exit 1
fi

store="$PWD/.jjmain"

# Guard the store itself — .jjmain is the anchor, never a workspace.
if [ "$name" = ".jjmain" ]; then
  echo "refusing to remove .jjmain — it is the shared store, not a workspace" >&2
  exit 1
fi

# Guard the workspace that lives in the store (named "meta" after the clone script ran).
store_ws=$(jj --repository "$store" workspace list 2>/dev/null | awk -F': ' -v p="$store" '$2 == p {print $1}')
if [ "$name" = "$store_ws" ]; then
  echo "refusing to remove '$name' — it is the shared store workspace, not a working copy" >&2
  exit 1
fi

# jj drops the workspace from the repo, removes its git worktree, and deletes the directory.
jj --repository "$store" workspace remove "$name"
