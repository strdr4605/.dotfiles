#!/bin/bash
# planck-agent: Planck EZ Glow as a herdr control deck.
#   focus N   focus herdr agent in slot N (1-12, row 1) and raise the terminal
#   key K     run the action config.json gives key K, named by keycap (rows 2-3)
#   log       toggle jj log + jj status panes beside the focused agent, without stealing focus
#   flag      toggle the focused agent back to blue (done) until it works or you refocus it
#   restart   reload the launchd LED loop after you edit this script or the plist
#   leds      loop: paint row 1 with agent states and rows 2-3 with key colours while the agent layer is active
set -eu
export PATH="$HOME/.cargo/bin:$HOME/.local/bin:/opt/homebrew/bin:$PATH"

CONFIG="${PLANCK_AGENT_CONFIG:-$HOME/.config/planck-agent/config.json}"
AGENT_LAYER="${PLANCK_AGENT_LAYER:-5}"
TERMINAL_APP="${PLANCK_TERMINAL_APP:-Alacritty}"
STALE_SECS="${PLANCK_STALE_SECS:-600}"
FLAG_FILE=/tmp/planck-agent.flagged
ROW2="escape a s d f g h j k l ; '"
ROW3="shift z x c v b n m , . / enter"
SPACE_LED=41
SCAN_SECS=10

main() {
  case "${1:-}" in
    focus) focus "$2" ;;
    key) key "$2" ;;
    log) log ;;
    flag) flag ;;
    restart) launchctl kickstart -k "gui/$(id -u)/planck-agent" ;;
    leds) leds ;;
    *) sed -n '2,7p' "$0"; exit 2 ;;
  esac
}

# shortcut: slots follow herdr sidebar order, so a new agent can shift slots; upgrade to sticky slots if it annoys
agents() {
  herdr agent list | jq -r '.result.agents[] | "\(.pane_id) \(.agent_status) \(.focused)"'
}

focused_pane() {
  local pane
  pane=$(herdr agent list | jq -r '.result.agents[] | select(.focused) | .pane_id')
  [ -n "$pane" ] || { echo "planck-agent: no herdr agent is focused" >&2; exit 1; }
  echo "$pane"
}

focus() {
  local pane
  pane=$(agents | sed -n "${1}p" | cut -d' ' -f1)
  [ -n "$pane" ] || exit 0
  herdr agent focus "$pane" >/dev/null
  open -a "$TERMINAL_APP"
}

cfg() { jq -r "$1 // empty" "$CONFIG"; }

# A key does one of: macro (type, unsubmitted), prompt (type and submit), keys (send key names), run (shell command).
key() {
  local k=$1 text
  if text=$(cfg ".keys[\"$k\"].macro") && [ -n "$text" ]; then
    herdr pane send-text "$(focused_pane)" "$text" >/dev/null
  elif text=$(cfg ".keys[\"$k\"].prompt") && [ -n "$text" ]; then
    herdr agent prompt "$(focused_pane)" "$text" >/dev/null
  elif text=$(cfg ".keys[\"$k\"].keys") && [ -n "$text" ]; then
    herdr agent send-keys "$(focused_pane)" $text >/dev/null
  elif text=$(cfg ".keys[\"$k\"].run") && [ -n "$text" ]; then
    sh -c "$text"
  else
    return
  fi
  flash "$k"
}

# LED index of a row 2-3 keycap: row 1 takes LEDs 0-11, then ROW2 and ROW3 in order
key_led() {
  local i=12 k
  for k in $ROW2 $ROW3; do
    [ "$k" = "$1" ] && { echo $i; return; }
    i=$((i+1))
  done
  return 1
}

# Blink the key white after its action ran, then put its colour back. Keymapp down is not an error here.
flash() {
  local led
  led=$(key_led "$1") || return 0
  kontroll set-rgb --led "$led" --color "#ffffff" >/dev/null || return 0
  sleep 0.15
  kontroll set-rgb --led "$led" --color "$(key_color "$1")" >/dev/null || true
}

# shortcut: one set of jj panes at a time, tracked in a tmp file; upgrade to per-agent panes if needed
LOG_PANE_FILE=/tmp/planck-agent.logpanes
log() {
  local pane cwd top bottom
  if [ -s "$LOG_PANE_FILE" ]; then
    for p in $(cat "$LOG_PANE_FILE"); do herdr pane close "$p" >/dev/null 2>&1 || true; done
    rm -f "$LOG_PANE_FILE"
    return
  fi
  pane=$(focused_pane)
  cwd=$(herdr agent list | jq -r --arg p "$pane" '.result.agents[] | select(.pane_id == $p) | .cwd')
  top=$(herdr pane split --pane "$pane" --direction right --ratio 0.35 --cwd "$cwd" --no-focus | jq -r '.result.pane.pane_id')
  bottom=$(herdr pane split --pane "$top" --direction down --cwd "$cwd" --no-focus | jq -r '.result.pane.pane_id')
  echo "$top $bottom" > "$LOG_PANE_FILE"
  herdr pane run "$top" "jj log" >/dev/null
  herdr pane run "$bottom" "jj status" >/dev/null
  herdr agent focus "$pane" >/dev/null
}

# Flagged agents paint blue (done) while idle, so a seen agent is not forgotten. The flag clears when the agent works or gets refocused.
flag() {
  local pane
  pane=$(focused_pane)
  if grep -qx "$pane" "$FLAG_FILE" 2>/dev/null; then
    sed -i '' "/^$pane\$/d" "$FLAG_FILE"
  else
    echo "$pane" >>"$FLAG_FILE"
  fi
}

# stdin: "pane status" lines. $1: previous "pane status since" lines. Prints "pane status since".
track() {
  awk -v now=$SECONDS 'NR==FNR { since[$1 FS $2]=$3; next } { k=$1 FS $2; print $1, $2, (k in since ? since[k] : now) }' <(echo "$1") -
}

# "pane status since" lines -> "pane status" lines: flagged idle becomes done, long idle becomes stale
frame_of() {
  local flagged
  flagged=" $(tr '\n' ' ' <"$FLAG_FILE") "
  awk -v now=$SECONDS -v stale="$STALE_SECS" -v flagged="$flagged" '
    $2 == "idle" && index(flagged, " " $1 " ") { $2 = "done" }
    $2 == "idle" && now - $3 > stale { $2 = "stale" }
    { print $1, $2 }' <<<"$1"
}

# Phrases in an agent's last reply that mean it waits for your go. Config "awaits_go" replaces the defaults.
go_phrases() {
  local p
  p=$(jq -r '(.awaits_go // empty)[]' "$CONFIG")
  if [ -n "$p" ]; then echo "$p"; else printf '%s\n' 'say "go"' 'say go' 'your "go"' 'your go' 'on your word' 'wait for my go' 'should i'; fi
}

# "pane ..." lines -> "pane flags" lines. Reads the detection buffer of each pane once.
scan() {
  local phrases p
  phrases=$(go_phrases)
  for p in $(cut -d' ' -f1 <<<"$1"); do
    echo "$p$(herdr agent read "$p" --source detection 2>/dev/null | detect "$phrases")"
  done
}

# stdin: a detection buffer. $1: go phrases, one per line. Prints the flags it finds, each with a space before it:
#   draft  the input box (the lines between the last two rules) has typed text
#   go     the last reply (after the last prompt line, above the input box) has a go phrase
#   heavy  the token-weather band near the input box shows 100% or more of the smart zone
# Claude marks prompts with ❯ and draws the band above the input box. Pi has no prompt marker,
# so its last reply is the last PI_REPLY_LINES non-blank lines above the input box, and its band is below the box.
detect() {
  PHRASES=$1 awk -v nbsp="$(printf '\302\240')" -v pi_reply="${PI_REPLY_LINES:-4}" '
    { line[NR] = $0 }
    index($0, "────") == 1 { top = bottom; bottom = NR }

    END {
      if (!top) exit
      for (i = top + 1; i < bottom; i++) {
        s = line[i]
        if (index(s, "❯") == 1) s = substr(s, length("❯") + 1)
        gsub(nbsp, "", s); gsub(/[ \t]/, "", s)
        if (s != "") { flags = flags " draft"; break }
      }

      start = 0
      for (i = 1; i < top; i++) if (index(line[i], "❯") == 1) start = i + 1
      if (!start) for (i = top - 1; i > 0 && n < pi_reply; i--) if (line[i] ~ /[^ \t]/) { start = i; n++ }
      for (i = (start > 1 ? start : 1); i < top; i++) reply = reply " " line[i]
      reply = tolower(reply); gsub(/[ \t]+/, " ", reply)
      n = split(tolower(ENVIRON["PHRASES"]), phrase, "\n")
      for (j = 1; j <= n; j++) if (phrase[j] != "" && index(reply, phrase[j])) { flags = flags " go"; break }

      for (i = top - 5; i <= NR; i++)
        if (i > 0 && (i < top || i > bottom) && match(line[i], /[0-9]+% of smart zone/) && substr(line[i], RSTART) + 0 >= 100) { flags = flags " heavy"; break }

      printf "%s", flags
    }'
}

# $1: "pane status" lines. $2: "pane flags" lines from scan. Prints "pane state", plus " draft" when the key must blink.
# go makes idle, done or stale agents awaits-go. heavy makes idle or stale agents heavy. A blocked agent never blinks.
mark() {
  awk 'NR == FNR { f[$1] = " " $0 " "; next }
    NF == 0 { next }
    {
      s = $2; x = f[$1]
      if (index(x, " go ") && (s == "idle" || s == "done" || s == "stale")) s = "awaits-go"
      else if (index(x, " heavy ") && (s == "idle" || s == "stale")) s = "heavy"
      print $1, s (index(x, " draft ") && s != "blocked" ? " draft" : "")
    }' <(echo "$2") <(echo "$1")
}

state_color() {
  local c
  c=$(cfg ".colors[\"$1\"]")
  case "$1" in
    blocked) echo "${c:-#ff0000}" ;;
    awaits-go) echo "${c:-#00ffff}" ;;
    working) echo "${c:-#ffa500}" ;;
    heavy) echo "${c:-#880000}" ;;
    done) echo "${c:-#0000ff}" ;;
    stale) echo "${c:-#aa00ff}" ;;
    idle) echo "${c:-#00ff00}" ;;
    *) echo "${c:-#202020}" ;;
  esac
}

key_color() {
  local c
  c=$(cfg ".keys[\"$1\"].color")
  echo "${c:-$(state_color empty)}"
}

worst() {
  for s in blocked awaits-go working done heavy stale idle; do grep -qE " $s( draft)?\$" <<<"$1" && { echo "$s"; return; }; done
  echo empty
}

# $1: state. $2: "draft" or empty. $3: blink phase, 1 on, 0 off. A draft key is dark in the off phase.
led_color() {
  if [ "$2" = draft ] && [ "$3" = 0 ]; then echo "#000000"; else state_color "$1"; fi
}

# The spacebar shows the worst state of all agents. It blinks if an agent has a draft, unless the worst state is blocked.
space_color() {
  local s draft=""
  s=$(worst "$1")
  [ "$s" != blocked ] && grep -q ' draft$' <<<"$1" && draft=draft
  led_color "$s" "$draft" "$2"
}

# $1: "pane state [draft]" lines for all agents. $2: blink phase (default 1, on). Row 1 shows the first 12 agents.
paint() {
  local frame=$1 phase=${2:-1} i=0 state draft k
  while [ $i -lt 12 ]; do
    read -r _ state draft <<<"$(sed -n "$((i+1))p" <<<"$frame")"
    kontroll set-rgb --led $i --color "$(led_color "${state:-empty}" "$draft" "$phase")" >/dev/null || return 1
    i=$((i+1))
  done
  for k in $ROW2 $ROW3; do
    kontroll set-rgb --led $i --color "$(key_color "$k")" >/dev/null || return 1
    i=$((i+1))
  done
  kontroll set-rgb --led $SPACE_LED --color "$(space_color "$frame" "$phase")" >/dev/null
}

# Repaint only the LEDs that blink: row 1 drafts and the spacebar.
blink() {
  local frame=$1 i=0 state draft
  while read -r _ state draft; do
    [ "$draft" = draft ] && { kontroll set-rgb --led $i --color "$(led_color "$state" draft "$2")" >/dev/null || return 1; }
    i=$((i+1))
  done < <(head -12 <<<"$frame")
  grep -q ' draft$' <<<"$frame" || return 0
  kontroll set-rgb --led $SPACE_LED --color "$(space_color "$frame" "$2")" >/dev/null
}

leds() {
  trap "kontroll restore-rgb-leds >/dev/null" EXIT
  local prev="" down="" layer frame list hist="" focused prevfocus="" tick=0 det="" scanned=-$SCAN_SECS phase
  touch "$FLAG_FILE"
  while :; do
    list=$(agents)
    hist=$(track "$hist" <<<"$list")
    # refocusing an agent counts as seeing it: drop its flag and restart its stale timer
    focused=$(awk '$3 == "true" { print $1 }' <<<"$list")
    if [ "$focused" != "$prevfocus" ] && [ -n "$focused" ]; then
      sed -i '' "/^$focused\$/d" "$FLAG_FILE"
      hist=$(awk -v p="$focused" -v now=$SECONDS '$1 == p { $3 = now } { print }' <<<"$hist")
    fi
    prevfocus=$focused
    for p in $(cat "$FLAG_FILE"); do grep -q "^$p working " <<<"$hist" && sed -i '' "/^$p\$/d" "$FLAG_FILE"; done
    layer=$(kontroll status 2>/dev/null | awk -F'\t+' '/Current layer/{print $2}')
    [ -n "$layer" ] || {
      [ -n "$down" ] || osascript -e 'display notification "Start Keymapp" with title "planck-agent"' || true
      down=1; kontroll connect-any >/dev/null 2>&1 || true; sleep 5; continue
    }
    down=""
    if [ "$layer" != "$AGENT_LAYER" ]; then
      [ -z "$prev" ] || { kontroll restore-rgb-leds >/dev/null || true; prev=""; }
      sleep 1; continue
    fi
    if [ $((SECONDS - scanned)) -ge $SCAN_SECS ]; then
      det=$(scan "$list")
      scanned=$SECONDS
    fi
    frame=$(mark "$(frame_of "$hist")" "$det")
    tick=$((tick+1))
    phase=$((tick % 2))

    # repaint on change or every 5s: Oryx firmware redraws layer colours on keypress
    if [ "$frame" != "$prev" ] || [ $((tick % 5)) -eq 0 ]; then
      paint "$frame" $phase && prev=$frame || { kontroll connect-any >/dev/null 2>&1 || true; prev=""; }
    else
      blink "$frame" $phase || { kontroll connect-any >/dev/null 2>&1 || true; prev=""; }
    fi
    sleep 1
  done
}

[ "${BASH_SOURCE[0]}" != "$0" ] || main "$@"
