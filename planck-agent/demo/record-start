#!/bin/bash
# planck-demo record-start: begin a take.
# The phone starts first. The screen follows, because the screen device needs
# about 2 seconds before it sends its first frame. The recording runs until
# you call record-stop, or until you press the stop key on the Planck.
#   record-start [output-path]
#
# The recorders run in the background. This script waits for the screen to be
# live, and then it says so with a sound and a notification.
set -eu

HERE="$(cd "$(dirname "$0")" && pwd)"
. "$HERE/common.sh"

OUT="${1:-/tmp/planck-demo-shot}"

if [ -f "$RECORD_STATE" ]; then
  echo "planck-demo: a recording is already running. Stop it first." >&2
  exit 1
fi

mkdir -p "$(dirname "$OUT")"

# Stop every recorder that is still running. A leftover screen recorder holds
# the capture device, and the next one then waits for it forever.
pkill -f 'ffmpeg.*avfoundation' 2>/dev/null || true
sleep 0.5
pkill -9 -f 'ffmpeg.*avfoundation' 2>/dev/null || true
sleep 0.5

rm -f "$OUT.screen.mov" "$OUT.phone.mov" "$OUT.mov" "$OUT.gif"
rm -f "$OUT.screen.log" "$OUT.phone.log" "$OUT.start.log"

# The lock comes first, so a second press cannot start a second pair.
cat >"$RECORD_STATE" <<EOF
OUT=$OUT
PHONE_PID=pending
SCREEN_PID=pending
PHONE_START=
SCREEN_START=
EOF

start_of() {
  sed -n 's/.*start: \([0-9.]*\).*/\1/p' "$1" 2>/dev/null | head -1
}

# The screen is live when the first frame is encoded, not when the device
# opens. The device needs about 2 seconds before it sends a frame.
frame_ready() {
  grep -q 'frame= *[1-9]' "$1" 2>/dev/null
}

# The recorders run in the background, so they keep going after this script
# returns. macOS drops a notification from an orphan process, so the sound and
# the notification go out from here, in the foreground.
(
  set +e

  nohup ffmpeg -y -f avfoundation -framerate 30 -i "${RECORD_PHONE_DEVICE}:none" \
    -vf "$RECORD_PHONE_FILTER" \
    -preset ultrafast -r 15 "$OUT.phone.mov" >"$OUT.phone.log" 2>&1 </dev/null &
  phone_pid=$!

  for _ in $(seq 1 120); do
    [ -n "$(start_of "$OUT.phone.log")" ] && break
    sleep 0.25
  done
  phone_start=$(start_of "$OUT.phone.log")

  sleep "$RECORD_PHONE_LEAD"

  nohup ffmpeg -y -f avfoundation -framerate 15 -pixel_format nv12 -i "${RECORD_SCREEN_DEVICE}:none" \
    -vf "$RECORD_SCREEN_FILTER" \
    -preset ultrafast -r 15 "$OUT.screen.mov" >"$OUT.screen.log" 2>&1 </dev/null &
  screen_pid=$!

  for _ in $(seq 1 240); do
    frame_ready "$OUT.screen.log" && break
    sleep 0.25
  done
  screen_start=$(start_of "$OUT.screen.log")

  cat >"$RECORD_STATE.tmp" <<EOF
OUT=$OUT
PHONE_PID=$phone_pid
SCREEN_PID=$screen_pid
PHONE_START=$phone_start
SCREEN_START=$screen_start
EOF
  mv "$RECORD_STATE.tmp" "$RECORD_STATE"
) >"$OUT.start.log" 2>&1 &

# Wait for the screen to be live, then tell the user.
live=0
for _ in $(seq 1 120); do
  if frame_ready "$OUT.screen.log"; then
    live=1
    break
  fi
  sleep 0.25
done

if [ "$live" -eq 0 ]; then
  echo "planck-demo: the screen did not go live. Read $OUT.screen.log." >&2
  exit 1
fi

record_signal

echo "==> the screen is live, act now"
