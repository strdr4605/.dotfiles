vars: {
  d2-config: {
    layout-engine: dagre
    pad: 30
  }
}

direction: right

# Input
keyboard: "Planck EZ" {
  shape: image
  icon: ./planck.png
  width: 400
  height: 170
}

# Hotkey layer (skhd or raycast)
hotkey: "hotkey layer\n(skhd or raycast)" {
  shape: rectangle
  style.fill: "#ffe0b3"
}

# Dispatcher
pa: "planck-agent\naction dispatcher" {
  shape: rectangle
  style.fill: "#b3d9ff"
  style.bold: true
}

# Config
config: "config.json\nkey -> {type, value, color}" {
  shape: page
}

# Terminal: grouped herdr / pane / shell
herdr: "herdr: panes CLI" {
  icon: ./ram.svg
  style.fill: "#f5f5f5"
  style.stroke: "#666666"
}
pane: "pane: agent process" {
  near: pa
  style.fill: "#f5f5f5"
  style.stroke: "#666666"
  style.font-color: "#aa8800"
  style.bold: true
}
shell: "shell: fork exec" {
  style.fill: "#f5f5f5"
  style.stroke: "#666666"
}

# Feedback
nled: "nLED\nper-key LED firmware" {
  shape: hexagon
  style.fill: "#1a1a1a"
  style.font-color: "#ffffff"
}

# Forward flow (blue)
keyboard -> hotkey: "Hyper+key" {
  style.stroke: "#0066cc"
  style.stroke-width: 2
}
hotkey -> pa: "name" {
  style.stroke: "#0066cc"
  style.stroke-width: 2
}
pa -> config: "lookup" {
  style.stroke: "#dcdcdc"
  style.stroke-width: 2
}
pa -> herdr: "exec" {
  style.stroke: "#0066cc"
  style.stroke-width: 2
}
pa -> pane: "type" {
  style.stroke: "#0066cc"
  style.stroke-width: 2
}
pa -> shell: "run" {
  style.stroke: "#0066cc"
  style.stroke-width: 2
}
herdr -> pane
shell -> pane
pa -> nled: "color" {
  style.stroke: "#cc4400"
  style.stroke-width: 2
}

# Feedback flow (red)
pane -> pa: "status" {
  style.stroke: "#cc4400"
  style.stroke-width: 2
}
nled -> keyboard: "visible" {
  style.stroke: "#cc4400"
  style.stroke-width: 2
  style.stroke-dash: 4
}
