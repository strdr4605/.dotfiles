vars: {
  d2-config: {
    layout-engine: tala
    pad: 30
  }
}

direction: up

keyboard: "Planck EZ Glow" {
  shape: image
  icon: ./planck.png
  width: 400
  height: 170
}

hotkey: "hotkey layer\n(skhd or raycast)" {
  shape: rectangle
  style.fill: "#ffe0b3"
}

pa: "planck-agent\naction dispatcher" {
  shape: rectangle
  style.fill: "#b3d9ff"
  style.bold: true
}

config: "config.json\nkey -> {macro | prompt | keys | run, color}" {
  shape: page
}

herdr: "herdr: agent panes" {
  icon: ./ram.svg
  style.fill: "#f5f5f5"
  style.stroke: "#666666"
}

shell: "sh -c" {
  style.fill: "#f5f5f5"
  style.stroke: "#666666"
}

keymapp: "Keymapp\n(kontroll)" {
  shape: hexagon
  style.fill: "#1a1a1a"
  style.font-color: "#ffffff"
}

# Forward flow (blue)
keyboard -> hotkey: "Hyper+key" {
  style.stroke: "#0066cc"
  style.stroke-width: 2
}
hotkey -> pa: "focus N / key K" {
  style.stroke: "#0066cc"
  style.stroke-width: 2
}
pa -> config: "lookup" {
  style.stroke: "#dcdcdc"
  style.stroke-width: 2
}
pa -> herdr: "focus, prompt,\nsend-text, send-keys" {
  style.stroke: "#0066cc"
  style.stroke-width: 2
}
pa -> shell: "run" {
  style.stroke: "#0066cc"
  style.stroke-width: 2
}

# Feedback flow (red)
herdr -> pa: "agent list (status)" {
  style.stroke: "#cc4400"
  style.stroke-width: 2
}
pa -> keymapp: "set-rgb" {
  style.stroke: "#cc4400"
  style.stroke-width: 2
}
keymapp -> keyboard: "LED colours" {
  style.stroke: "#cc4400"
  style.stroke-width: 2
  style.stroke-dash: 4
}
