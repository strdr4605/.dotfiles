#!/usr/bin/env python3
"""Draw today's office background with a cork board, then put it in Teams.

Teams has no API to select a background. We overwrite the selected upload:
the file name stays the same, the content changes.

Usage:
  teams-bg            draw the image, keep a copy in ARCHIVE, write it over the Teams upload
  teams-bg out.png    draw the image to out.png only (preview)
"""
import datetime
import glob
import json
import os
import random
import string
import subprocess
import sys
import tempfile
import textwrap
import urllib.parse
import urllib.request
from html import escape

CITY = os.environ.get("TEAMS_BG_CITY", "Chișinău")
UPLOADS = os.environ.get("TEAMS_BG_UPLOADS", os.path.expanduser(
    "~/Library/Containers/com.microsoft.teams2/Data/Library/Application Support/Microsoft/MSTeams/Backgrounds/Uploads"))
ARCHIVE = os.path.expanduser("~/Pictures/teams-bg-archive")
CHROME = "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"


def main():
    if len(sys.argv) > 1:
        render(sys.argv[1])
        return

    target = selected_upload()

    os.makedirs(ARCHIVE, exist_ok=True)
    png = os.path.join(ARCHIVE, f"{datetime.datetime.now():%Y-%m-%d_%H%M}.png")
    render(png)
    install(png, target)

    print(f"teams-bg: {os.path.basename(png)} -> {os.path.basename(target)}")


def selected_upload():
    uploads = [f for f in glob.glob(os.path.join(UPLOADS, "*")) if "_thumb." not in f]
    if len(uploads) != 1:
        sys.exit(f"teams-bg: need exactly 1 upload in Teams, found {len(uploads)}")
    return uploads[0]


def install(png, target):
    root, ext = os.path.splitext(target)
    thumb = f"{root}_thumb{ext}"

    sips("-s", "format", sips_value(target, "format"), png, "--out", target)

    if os.path.exists(thumb):
        sips("-Z", sips_value(thumb, "pixelWidth"), target, "--out", thumb)


def render(out):
    page = string.Template(PAGE).substitute({k: escape(v) for k, v in notes(datetime.date.today()).items()})

    with tempfile.NamedTemporaryFile("w", suffix=".html", delete=False, encoding="utf-8") as f:
        f.write(page)

    try:
        subprocess.run([CHROME, "--headless", "--disable-gpu", "--hide-scrollbars", "--window-size=1920,1080",
                        f"--screenshot={os.path.abspath(out)}", f"file://{f.name}"],
                       check=True, capture_output=True, timeout=60)
    finally:
        os.unlink(f.name)


def notes(today):
    weather = fetch(f"https://wttr.in/{urllib.parse.quote(CITY)}?m&format=%c+%t,+%C") or ""
    if "°" not in weather:  # wttr sends errors as plain text
        weather = "weather report lost in the mail"

    fact = (json_or_empty(fetch("https://uselessfacts.jsph.pl/api/v2/facts/today"))
            .get("text", "The fact machine is broken. Please submit a ticket."))

    holidays = [h["text"] for h in json_or_empty(fetch(
        f"https://api.wikimedia.org/feed/v1/wikipedia/en/onthisday/holidays/{today:%m}/{today:%d}")).get("holidays", [])
        if "\n" not in h["text"]]  # entries with "\n" are long lists of feast days
    holiday = random.Random(today.toordinal()).choice(holidays) if holidays else "Nothing. Just another workday."

    return {
        "weekday": f"{today:%A}",
        "date": f"{today.day} {today:%B %Y}",
        "city": CITY,
        "weather": weather.strip(),
        "fact": textwrap.shorten(fact, 100, placeholder="…"),
        "holiday": textwrap.shorten(holiday, 70, placeholder="…"),
    }


def fetch(url):
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "teams-bg/1.0"})
        with urllib.request.urlopen(req, timeout=10) as r:
            return r.read().decode()
    except Exception:  # offline or API down: the note shows a fallback text
        return None


def json_or_empty(text):
    try:
        return json.loads(text) if text else {}
    except ValueError:
        return {}


def sips(*args):
    subprocess.run(["sips", *args], check=True, capture_output=True)


def sips_value(path, key):
    out = subprocess.run(["sips", "-g", key, path], check=True, capture_output=True, text=True).stdout
    return out.split(f"{key}:")[1].split()[0]


